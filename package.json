  "type": "module",
  "private": true,
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "bun run --parallel dev:server dev:css",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:css": "bunx tailwindcss -i ./src/client/input.css -o ./src/client/styles.css --watch",
    "build:css": "bunx tailwindcss -i ./src/client/input.css -o ./src/client/styles.css --minify",
    "migrate": "prisma migrate dev",
    "import": "bun run src/import.ts"
  }
