generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Debt {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  debtSubject String
  debtAmount  Int // cents (EUR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}