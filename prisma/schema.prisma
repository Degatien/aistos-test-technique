generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Debtor {
  emailHash String   @id // HMAC-SHA256(email) — deterministic PK for set-based upsert
  slug      String   @unique
  name      String
  email     String
  debts     Debt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Debt {
  id          String     @id @default(cuid())
  debtorId    String
  debtor      Debtor     @relation(fields: [debtorId], references: [emailHash], onDelete: Cascade)
  debtSubject String
  debtAmount  Int // euros as in the CSV; converted to cents only for Stripe
  status      DebtStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum DebtStatus {
  PENDING
  PAID
}